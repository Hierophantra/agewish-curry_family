# .env.local.example
# Copy to .env.local and fill in the values before running the app.
# This file is committed to git. .env.local is NOT committed (see .gitignore).

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────

# Required: JWT encryption key for session cookies.
# Generate with: npx auth secret
# Or: openssl rand -base64 32
AUTH_SECRET=

# Required: bcrypt hash of the shared family password.
# Generate with: node -e "require('bcryptjs').hash('<your-password>', 10).then(console.log)"
# The hash starts with $2a$ or $2b$.
#
# IMPORTANT: Escape each $ with a backslash when writing to this file.
# @next/env runs dotenv-expand, which mangles bcrypt hashes by treating $2b, $10, etc. as
# variable references. Single quotes do NOT prevent this — only backslash escapes do.
#
# Example (the correct format for a hash like $2b$10$F2x7R9...):
#   AUTH_PASSWORD_HASH=\$2b\$10\$F2x7R9...
#
# On Vercel: paste the raw hash WITHOUT backslashes — Vercel's env UI does not run dotenv-expand.
AUTH_PASSWORD_HASH=

# ─── Admin (v3) ───────────────────────────────────────────────────────────────

# GitHub OAuth App credentials (https://github.com/settings/developers)
# Required for admin login at /admin. The OAuth app must have:
#   Authorization callback URL (local dev):  http://localhost:3000/api/auth/callback/github
#   Authorization callback URL (production): https://curry.agewish.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of GitHub usernames allowed to access /admin.
# Anyone NOT in this list will be refused even if their GitHub login succeeds.
# Example: ADMIN_GITHUB_USERNAMES=Hierophantra
# Example (multiple): ADMIN_GITHUB_USERNAMES=Hierophantra,secondadmin
ADMIN_GITHUB_USERNAMES=

# ─── Vercel Blob (file uploads) ───────────────────────────────────────────────

# Read/write token for the Vercel Blob store. Required for:
#   - the admin photo/audio uploaders
#   - the family image-upload + gallery feature (/upload, /gallery)
# Without it, those upload APIs return 503 and the gallery shows an empty state.
#
# On Vercel: create or connect a Blob store under the project's Storage tab —
# Vercel injects BLOB_READ_WRITE_TOKEN automatically (no manual paste needed).
# Locally: copy the token from the Blob store's ".env.local" snippet in the
# Vercel dashboard, or run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# ─── DO NOT SET THESE ─────────────────────────────────────────────────────────
# NEXTAUTH_SECRET — Auth.js v4 name. Does nothing in v5. Use AUTH_SECRET above.
# NEXTAUTH_URL    — Breaks Vercel preview deployments. Vercel auto-detects via VERCEL_URL.
# AUTH_URL        — Same issue. Leave unset for Vercel deployments.
